# Copy to .env and adjust. Never commit .env.

# LLM: "gemini" for real runs, "mock" for offline/deterministic runs,
# "mock_compromised" to demo guardrails against a model that obeys injections.
LLM_PROVIDER=mock
LLM_TIMEOUT_MS=30000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite-preview

# Demo auth. Login with username agent | manager | admin and this password.
DEMO_PASSWORD=trustdesk
# token:userId:role triples used as bearer tokens
DEMO_TOKENS=agent-demo-token:agent_priya:agent,manager-demo-token:mgr_rohan:manager,admin-demo-token:admin_sara:admin

# Calendar used to turn ticket timestamps into policy dates.
BUSINESS_TIMEZONE=Asia/Kolkata

# Seed the starter data on every start (idempotent).
SEED_ON_START=true

# Only needed when running outside Docker (docker-compose sets it for the app).
# DATABASE_URL=postgres://trustdesk:trustdesk@localhost:5432/trustdesk
